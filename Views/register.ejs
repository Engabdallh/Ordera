<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <meta name="theme-color" content="#090909">

    <title>
        إنشاء حساب - 911
    </title>

    <link rel="stylesheet" href="/css/register.css">

</head>

<body>

    <main class="register-page">

        <section class="register-card">

            <!-- =================================
                 BRAND
            ================================== -->

            <div class="brand-area">

                <div class="logo">
                    سلسلة مطاعم
                </div>

                <div class="brand-name">
                    911
                </div>

            </div>


            <!-- =================================
                 TITLE
            ================================== -->

            <div class="title-area">

                <span class="register-badge">
                    ✨ انضم إلينا
                </span>

                <h1>
                    إنشاء حساب
                </h1>

                <p>
                    أنشئ حسابك واستمتع بتجربة 911
                </p>

            </div>


            <!-- =================================
                 ERROR
            ================================== -->

            <% if (typeof error !=="undefined" && error) { %>

                <div class="error-message">

                    <span class="message-icon">
                        !
                    </span>

                    <span>
                        <%= error %>
                    </span>

                </div>

                <% } %>


                    <!-- =================================
                 REGISTER FORM
            ================================== -->

                    <form action="/registration" method="POST" class="register-form">


                        <!-- NAME -->

                        <div class="input-group">

                            <label for="name">
                                الاسم
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    👤
                                </span>

                                <input type="text" id="name" name="name" placeholder="أدخل اسمك" autocomplete="name"
                                    required>

                            </div>

                        </div>


                        <!-- PHONE -->

                        <div class="input-group">

                            <label for="phone">
                                رقم الهاتف
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    📱
                                </span>

                                <input type="tel" id="phone" name="phone" placeholder="أدخل رقم الهاتف"
                                    autocomplete="tel" inputmode="tel" required>

                            </div>

                        </div>


                        <!-- ADDRESS -->

                        <div class="input-group">

                            <label for="address">
                                العنوان
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    📍
                                </span>

                                <input type="text" id="address" name="address" placeholder="أدخل عنوانك"
                                    autocomplete="street-address" required>

                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="input-group">

                            <label for="email">
                                البريد الإلكتروني
                            </label>

                            <div class="input-wrapper">

                                <span class="input-icon">
                                    ✉️
                                </span>

                                <input type="email" id="email" name="email" placeholder="أدخل البريد الإلكتروني"
                                    autocomplete="email" required>

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="input-group">

                            <label for="password">
                                كلمة السر
                            </label>

                            <div class="password-input">

                                <span class="input-icon">
                                    🔒
                                </span>

                                <input type="password" id="password" name="password" placeholder="أنشئ كلمة سر"
                                    autocomplete="new-password" required>

                                <button type="button" class="toggle-password" onclick="togglePassword('password', this)"
                                    aria-label="إظهار كلمة السر">
                                    👁
                                </button>

                            </div>

                        </div>

                        <!-- CONFIRM PASSWORD -->

                        <div class="input-group">

                            <label for="confirmPassword">
                                تأكيد كلمة السر
                            </label>

                            <div class="password-input">

                                <span class="input-icon">
                                    🔐
                                </span>

                                <input type="password" id="confirmPassword" name="confirmPassword"
                                    placeholder="أعد كتابة كلمة السر" autocomplete="new-password" required>

                                <button type="button" class="toggle-password"
                                    onclick="togglePassword('confirmPassword', this)"
                                    aria-label="إظهار تأكيد كلمة السر">
                                    👁
                                </button>

                            </div>

                        </div>


                        <!-- SUBMIT -->

                        <button type="submit" class="register-btn">

                            <span>
                                إنشاء الحساب
                            </span>

                            <span>
                                ←
                            </span>

                        </button>

                    </form>


                    <!-- =================================
                 LOGIN
            ================================== -->

                    <div class="login-area">

                        <p>
                            لديك حساب بالفعل؟
                        </p>

                        <a href="/login">
                            تسجيل الدخول
                        </a>

                    </div>


                    <!-- =================================
                 DIVIDER
            ================================== -->

                    <div class="divider">

                        <span>
                            أو
                        </span>

                    </div>


                    <!-- =================================
                 GUEST
            ================================== -->

                    <a href="/guest" class="guest-link">
                        🚀 المتابعة كزائر
                    </a>


                    <!-- =================================
                 HELP
            ================================== -->

                    <a href="/register-help" class="help-link">
                        ❓ كيف أنشئ حساب؟
                    </a>


                    <!-- =================================
                 FOOTER
            ================================== -->

                    <div class="register-footer">

                        <span>
                            911 Restaurant
                        </span>

                        <span class="footer-dot">
                            •
                        </span>

                        <span>
                            أهلاً بك معنا
                        </span>

                    </div>

        </section>

    </main>


    <script src="/js/register.js" defer></script>

</body>

</html>