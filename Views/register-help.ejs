<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    >

    <meta
        name="theme-color"
        content="#090909"
    >

    <title>
        كيف أنشئ حساب؟ | 911
    </title>

    <link
        rel="stylesheet"
        href="/css/register-help.css"
    >

</head>

<body>

    <main class="register-help-page">

        <section class="register-help-card">

            <!-- =================================
                 BRAND
            ================================== -->

            <div class="brand-area">

                <div class="logo">
                    سلسلة مطاعم
                </div>

                <div class="brand-name">
                    911 
                </div>

            </div>


            <!-- =================================
                 HERO
            ================================== -->

            <div class="hero">

                <span class="help-badge">
                    ❓ دليل إنشاء الحساب
                </span>

                <h1>
                    كيف أنشئ حسابًا؟
                </h1>

                <p>
                    اتبع الخطوات التالية لإنشاء حسابك
                    في 911 والاستفادة من ميزات العملاء المسجلين.
                </p>

            </div>


            <!-- =================================
                 STEPS
            ================================== -->

            <section class="steps">


                <!-- STEP 1 -->

                <div class="step">

                    <div class="step-number">
                        1
                    </div>

                    <div class="step-icon">
                        ✨
                    </div>

                    <div class="step-content">

                        <h3>
                            اضغط إنشاء حساب جديد
                        </h3>

                        <p>
                            من صفحة البداية أو صفحة تسجيل الدخول
                            اضغط على زر "إنشاء حساب جديد".
                        </p>

                    </div>

                </div>


                <!-- STEP 2 -->

                <div class="step">

                    <div class="step-number">
                        2
                    </div>

                    <div class="step-icon">
                        👤
                    </div>

                    <div class="step-content">

                        <h3>
                            اكتب اسمك
                        </h3>

                        <p>
                            أدخل الاسم الذي تريد استخدامه
                            داخل حسابك.
                        </p>

                    </div>

                </div>


                <!-- STEP 3 -->

                <div class="step">

                    <div class="step-number">
                        3
                    </div>

                    <div class="step-icon">
                        📱
                    </div>

                    <div class="step-content">

                        <h3>
                            أدخل رقم الهاتف
                        </h3>

                        <p>
                            اكتب رقم هاتف صحيح حتى تكون
                            معلومات الاتصال الخاصة بك صحيحة.
                        </p>

                    </div>

                </div>


                <!-- STEP 4 -->

                <div class="step">

                    <div class="step-number">
                        4
                    </div>

                    <div class="step-icon">
                        📍
                    </div>

                    <div class="step-content">

                        <h3>
                            أدخل العنوان
                        </h3>

                        <p>
                            اكتب عنوانك بشكل واضح حتى
                            يتم استخدامه عند الطلب.
                        </p>

                    </div>

                </div>


                <!-- STEP 5 -->

                <div class="step">

                    <div class="step-number">
                        5
                    </div>

                    <div class="step-icon">
                        ✉️
                    </div>

                    <div class="step-content">

                        <h3>
                            أدخل البريد الإلكتروني
                        </h3>

                        <p>
                            اكتب بريدًا إلكترونيًا صحيحًا
                            وغير مستخدم من قبل.
                        </p>

                    </div>

                </div>


                <!-- STEP 6 -->

                <div class="step">

                    <div class="step-number">
                        6
                    </div>

                    <div class="step-icon">
                        🔒
                    </div>

                    <div class="step-content">

                        <h3>
                            أنشئ كلمة السر
                        </h3>

                        <p>
                            اكتب كلمة سر لا تقل عن
                            8 أحرف.
                        </p>

                    </div>

                </div>


                <!-- STEP 7 -->

                <div class="step">

                    <div class="step-number">
                        7
                    </div>

                    <div class="step-icon">
                        🔐
                    </div>

                    <div class="step-content">

                        <h3>
                            أكد كلمة السر
                        </h3>

                        <p>
                            أعد كتابة كلمة السر في خانة
                            "تأكيد كلمة السر" وتأكد أنها مطابقة.
                        </p>

                    </div>

                </div>


                <!-- STEP 8 -->

                <div class="step">

                    <div class="step-number">
                        8
                    </div>

                    <div class="step-icon">
                        ✅
                    </div>

                    <div class="step-content">

                        <h3>
                            اضغط إنشاء الحساب
                        </h3>

                        <p>
                            إذا كانت جميع البيانات صحيحة،
                            سيتم إنشاء حسابك بنجاح.
                        </p>

                    </div>

                </div>

            </section>


            <!-- =================================
                 IMPORTANT NOTE
            ================================== -->

            <div class="help-note">

                <div class="help-note-icon">
                    💡
                </div>

                <div>

                    <strong>
                        ملاحظة مهمة
                    </strong>

                    <p>
                        يجب أن تكون كلمتا السر متطابقتين،
                        ويجب أن يكون البريد الإلكتروني
                        غير مستخدم مسبقًا.
                    </p>

                </div>

            </div>


            <!-- =================================
                 AFTER REGISTRATION
            ================================== -->

            <div class="success-note">

                <div class="success-note-icon">
                    🎉
                </div>

                <div>

                    <strong>
                        بعد إنشاء الحساب
                    </strong>

                    <p>
                        سيتم نقلك إلى صفحة تسجيل الدخول،
                        ومن هناك تستطيع الدخول إلى حسابك
                        باستخدام اسمك وكلمة السر.
                    </p>

                </div>

            </div>


            <!-- =================================
                 ACTIONS
            ================================== -->

            <div class="actions">

                <a
                    href="/register"
                    class="primary-btn"
                >
                    ✨ إنشاء حساب الآن
                </a>

                <a
                    href="/login-help"
                    class="secondary-btn"
                >
                    🔐 كيف أسجل الدخول؟
                </a>

                <a
                    href="/login"
                    class="login-btn"
                >
                    العودة لتسجيل الدخول
                </a>

            </div>


            <!-- =================================
                 FOOTER
            ================================== -->

            <footer>

                <span>
                    911 Restaurant
                </span>

                <span>
                    •
                </span>

                <span>
                    نحن هنا لمساعدتك
                </span>

            </footer>

        </section>

    </main>

</body>
</html>