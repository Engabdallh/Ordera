<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>إدارة الكوبونات</title>

    <link rel="stylesheet" href="/css/admin/admincoupons.css">

</head>

<body>

    <div class="dashboard">

        <!-- ============================== -->
        <!-- Header -->
        <!-- ============================== -->

        <header class="header">

            <div>

                <h1>ordera</h1>

                <p>
                    إدارة الكوبونات
                </p>

            </div>

            <div class="header-actions">

                <a href="/admin" class="btn dashboard-btn">
                    لوحة التحكم
                </a>

                <div class="logo">
                    ordera
                </div>

            </div>

        </header>


        <!-- ============================== -->
        <!-- المحتوى -->
        <!-- ============================== -->

        <main class="content">

            <div class="coupon-page">


                <!-- ============================== -->
                <!-- عنوان الصفحة -->
                <!-- ============================== -->

                <div class="coupon-header">

                    <h2>
                        🎟️ إدارة الكوبونات
                    </h2>

                    <p>
                        إضافة وإدارة كوبونات الخصم الخاصة بالمطعم.
                    </p>

                </div>


                <!-- ============================== -->
                <!-- رسائل النظام -->
                <!-- ============================== -->

                <% if (success) { %>

                    <div class="coupon-message coupon-success">

                        <%= success %>

                    </div>

                    <% } %>


                        <% if (error) { %>

                            <div class="coupon-message coupon-error">

                                <%= error %>

                            </div>

                            <% } %>


                                <!-- ============================== -->
                                <!-- إضافة كوبون -->
                                <!-- ============================== -->

                                <div class="coupon-form-card">

                                    <h3>
                                        ➕ إضافة كوبون جديد
                                    </h3>


                                    <form action="/admin/coupons" method="POST">

                                        <div class="coupon-form-grid">


                                            <!-- كود الكوبون -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    كود الكوبون
                                                </label>

                                                <input type="text" name="code" placeholder="ORDERA20" maxlength="50"
                                                    required>

                                            </div>


                                            <!-- نوع الخصم -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    نوع الخصم
                                                </label>

                                                <select name="discountType" required>

                                                    <option value="percentage">
                                                        نسبة مئوية (%)
                                                    </option>

                                                    <option value="fixed">
                                                        مبلغ ثابت (د.أ)
                                                    </option>

                                                </select>

                                            </div>


                                            <!-- قيمة الخصم -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    قيمة الخصم
                                                </label>

                                                <input type="number" name="discountValue" min="0" step="0.01"
                                                    placeholder="10" required>

                                            </div>


                                            <!-- الحد الأدنى -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    الحد الأدنى للطلب
                                                </label>

                                                <input type="number" name="minOrderAmount" min="0" step="0.01" value="0"
                                                    placeholder="5">

                                            </div>


                                            <!-- الحد الإجمالي للاستخدام -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    الحد الإجمالي للاستخدام
                                                </label>

                                                <input type="number" name="usageLimit" min="1" step="1"
                                                    placeholder="مثال: 100">

                                                <small>
                                                    اتركه فارغًا إذا كان بدون حد
                                                </small>

                                            </div>


                                            <!-- حد الاستخدام لكل عميل -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    حد الاستخدام لكل عميل
                                                </label>

                                                <input type="number" name="usageLimitPerCustomer" min="1" step="1"
                                                    placeholder="مثال: 2">

                                                <small>
                                                    اتركه فارغًا إذا كان بدون حد
                                                </small>

                                            </div>


                                            <!-- تاريخ الانتهاء -->

                                            <div class="coupon-form-group">

                                                <label>
                                                    تاريخ انتهاء الكوبون
                                                </label>

                                                <input type="datetime-local" name="expiresAt">

                                            </div>


                                        </div>


                                        <button type="submit" class="coupon-add-btn">
                                            إضافة الكوبون
                                        </button>

                                    </form>

                                </div>


                                <!-- ============================== -->
                                <!-- قائمة الكوبونات -->
                                <!-- ============================== -->

                                <div class="coupons-list-card">

                                    <h3>
                                        📋 الكوبونات الحالية
                                    </h3>


                                    <% if (coupons.length===0) { %>

                                        <div class="no-coupons">

                                            لا يوجد كوبونات حاليًا.

                                        </div>

                                        <% } else { %>


                                            <div class="coupons-table-container">

                                                <table class="coupons-table">

                                                    <thead>

                                                        <tr>

                                                            <th>
                                                                الكود
                                                            </th>

                                                            <th>
                                                                نوع الخصم
                                                            </th>

                                                            <th>
                                                                قيمة الخصم
                                                            </th>

                                                            <th>
                                                                الحد الأدنى
                                                            </th>

                                                            <th>
                                                                الحد الإجمالي
                                                            </th>

                                                            <th>
                                                                حد العميل
                                                            </th>

                                                            <th>
                                                                الاستخدام الحالي
                                                            </th>

                                                            <th>
                                                                تاريخ الانتهاء
                                                            </th>

                                                            <th>
                                                                الحالة
                                                            </th>

                                                            <th>
                                                                الإجراء
                                                            </th>

                                                        </tr>

                                                    </thead>


                                                    <tbody>

                                                        <% coupons.forEach(coupon=> { %>

                                                            <tr>


                                                                <!-- الكود -->

                                                                <td>

                                                                    <span class="coupon-code">

                                                                        <%= coupon.code %>

                                                                    </span>

                                                                </td>


                                                                <!-- نوع الخصم -->

                                                                <td>

                                                                    <% if (coupon.discount_type==="percentage" ) { %>

                                                                        نسبة مئوية

                                                                        <% } else { %>

                                                                            مبلغ ثابت

                                                                            <% } %>

                                                                </td>


                                                                <!-- قيمة الخصم -->

                                                                <td>

                                                                    <%= coupon.discount_value %>

                                                                        <% if (coupon.discount_type==="percentage" ) {
                                                                            %>

                                                                            %

                                                                            <% } else { %>

                                                                                د.أ

                                                                                <% } %>

                                                                </td>


                                                                <!-- الحد الأدنى -->

                                                                <td>

                                                                    <%= coupon.min_order_amount %>
                                                                        د.أ

                                                                </td>


                                                                <!-- الحد الإجمالي -->

                                                                <td>

                                                                    <%= coupon.usage_limit !==null ? coupon.usage_limit
                                                                        : "بدون حد" %>

                                                                </td>


                                                                <!-- حد العميل -->

                                                                <td>

                                                                    <%= coupon.usage_limit_per_customer !==null ?
                                                                        coupon.usage_limit_per_customer : "بدون حد" %>

                                                                </td>


                                                                <!-- الاستخدام الحالي -->

                                                                <td>

                                                                    <%= coupon.usage_count || 0 %>

                                                                </td>


                                                                <!-- تاريخ الانتهاء -->

                                                                <td>

                                                                    <%= coupon.expires_at || "بدون انتهاء" %>

                                                                </td>


                                                                <!-- الحالة -->

                                                                <td>

                                                                    <% if (coupon.is_active) { %>

                                                                        <span class="coupon-status active">

                                                                            فعال

                                                                        </span>

                                                                        <% } else { %>

                                                                            <span class="coupon-status inactive">

                                                                                غير فعال

                                                                            </span>

                                                                            <% } %>

                                                                </td>


                                                                <!-- الإجراء -->

                                                                <td>


                                                                    <!-- تفعيل / تعطيل -->

                                                                    <form
                                                                        action="/admin/coupons/toggle/<%= coupon.id %>"
                                                                        method="POST" style="display: inline;">

                                                                        <button type="submit" class="coupon-toggle-btn">

                                                                            <% if (coupon.is_active) { %>

                                                                                تعطيل

                                                                                <% } else { %>

                                                                                    تفعيل

                                                                                    <% } %>

                                                                        </button>

                                                                    </form>


                                                                    <!-- حذف -->

                                                                    <form
                                                                        action="/admin/coupons/delete/<%= coupon.id %>"
                                                                        method="POST" style="display: inline;"
                                                                        onsubmit="return confirm('هل أنت متأكد من حذف هذا الكوبون؟');">

                                                                        <button type="submit" class="coupon-delete-btn">

                                                                            حذف

                                                                        </button>

                                                                    </form>


                                                                </td>


                                                            </tr>

                                                            <% }) %>

                                                    </tbody>

                                                </table>

                                            </div>

                                            <% } %>

                                </div>

            </div>

        </main>


        <!-- ============================== -->
        <!-- Footer -->
        <!-- ============================== -->

        <footer>

            <p>
                911 Restaurant © 2026
            </p>

        </footer>

    </div>

</body>

</html>