<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>تقييمات موظفي الدعم | 911</title>

  <link rel="stylesheet" href="/css/admin/support-ratings.css">
</head>

<body>

  <main class="page">

    <!-- ==============================
         HEADER
    =============================== -->

    <section class="header">

      <div class="header-title">

        <h1>
          📊 تقييمات وأداء موظفي الدعم
        </h1>

        <p>
          متابعة أداء موظفي الكول سنتر وتحليل تقييمات العملاء
        </p>

      </div>

      <a href="/admin" class="back-btn">
        ← لوحة الإدارة
      </a>

    </section>


    <!-- ==============================
         SEARCH
    =============================== -->

    <section class="search-card">

      <div class="search-title">
        🔎 ابحث عن موظف
      </div>

      <div class="search-row">

        <input type="text" id="employeeNameInput" class="search-input" placeholder="اكتب اسم الموظف..."
          autocomplete="off">

        <button type="button" id="searchEmployeeBtn" class="search-btn">
          🔍 عرض التقرير
        </button>

      </div>

      <div id="message" class="message"></div>

    </section>


    <!-- ==============================
         EMPLOYEE HEADER
    =============================== -->

    <section id="employeeHeader" class="employee-header">

      <div class="employee-info">

        <h2 id="employeeName">
          -
        </h2>

        <p>
          تقرير أداء موظف الدعم
        </p>

      </div>

      <div class="employee-rating">

        <div id="averageRating" class="employee-rating-value">
          0.00
        </div>

        <div id="averageStars" class="employee-rating-stars">
          -
        </div>

      </div>

    </section>


    <!-- ==============================
         STATS
    =============================== -->

    <section id="statsGrid" class="stats-grid" style="display:none;">

      <div class="stat-card">

        <div class="stat-label">
          إجمالي المحادثات المستلمة
        </div>

        <div id="totalAssigned" class="stat-value">
          0
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-label">
          المحادثات التي تم الرد عليها
        </div>

        <div id="respondedConversations" class="stat-value green">
          0
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-label">
          إجمالي الرسائل المرسلة
        </div>

        <div id="totalMessages" class="stat-value orange">
          0
        </div>

      </div>


      <div class="stat-card">

        <div class="stat-label">
          نسبة الرد
        </div>

        <div id="responseRate" class="stat-value orange">
          0%
        </div>

      </div>

    </section>


    <!-- ==============================
         CONTENT
    =============================== -->

    <section id="contentGrid" class="content-grid" style="display:none;">

      <!-- ==========================
           RATING BREAKDOWN
      =========================== -->

      <div class="panel">

        <div class="panel-header">
          ⭐ توزيع تقييمات العملاء
        </div>

        <div class="rating-breakdown">

          <!-- 5 -->
          <div class="rating-row">

            <div class="rating-stars">
              5 ⭐
            </div>

            <div class="rating-bar">

              <div id="bar5" class="rating-bar-fill"></div>

            </div>

            <div id="count5" class="rating-count">
              0
            </div>

          </div>


          <!-- 4 -->
          <div class="rating-row">

            <div class="rating-stars">
              4 ⭐
            </div>

            <div class="rating-bar">

              <div id="bar4" class="rating-bar-fill"></div>

            </div>

            <div id="count4" class="rating-count">
              0
            </div>

          </div>


          <!-- 3 -->
          <div class="rating-row">

            <div class="rating-stars">
              3 ⭐
            </div>

            <div class="rating-bar">

              <div id="bar3" class="rating-bar-fill"></div>

            </div>

            <div id="count3" class="rating-count">
              0
            </div>

          </div>


          <!-- 2 -->
          <div class="rating-row">

            <div class="rating-stars">
              2 ⭐
            </div>

            <div class="rating-bar">

              <div id="bar2" class="rating-bar-fill"></div>

            </div>

            <div id="count2" class="rating-count">
              0
            </div>

          </div>


          <!-- 1 -->
          <div class="rating-row">

            <div class="rating-stars">
              1 ⭐
            </div>

            <div class="rating-bar">

              <div id="bar1" class="rating-bar-fill"></div>

            </div>

            <div id="count1" class="rating-count">
              0
            </div>

          </div>

        </div>

      </div>


      <!-- ==========================
           RATINGS TABLE
      =========================== -->

      <div class="panel">

        <div class="panel-header">
          💬 تفاصيل تقييمات العملاء
        </div>

        <div id="ratingsContainer" class="table-wrapper">

          <div class="empty">
            ابحث عن موظف لعرض التقييمات.
          </div>

        </div>

      </div>

    </section>

  </main>


  <script src="/js/admin/support-ratings.js"></script>

</body>

</html>