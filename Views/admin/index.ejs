<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>لوحة تحكم 911 | Admin</title>

    <link
        rel="stylesheet"
        href="/css/admin/admin.css"
    >
</head>

<body>

    <div class="dashboard">

        <!-- =========================================
             SIDEBAR
        ========================================== -->

        <aside class="sidebar">

            <div class="sidebar-brand">

                 <strong>
                        سلسلة مطاعم
                    </strong>

                <div>
                   
                    <div class="brand-logo">
                    911
                </div>
                    <span>
                        Admin Dashboard
                    </span>
                </div>

            </div>


            <nav class="sidebar-nav">

                <div class="nav-title">
                    الرئيسية
                </div>

                <a
                    href="/admin"
                    class="nav-item active"
                >
                    <span class="nav-icon">
                        🏠
                    </span>

                    <span>
                        لوحة التحكم
                    </span>
                </a>


                <div class="nav-title">
                    إدارة المطعم
                </div>

                <a
                    href="/admin/orders"
                    class="nav-item"
                >
                    <span class="nav-icon">
                        📦
                    </span>

                    <span>
                        الطلبات
                    </span>
                </a>


                <a
                    href="/admin/products"
                    class="nav-item"
                >
                    <span class="nav-icon">
                        🍔
                    </span>

                    <span>
                        المنتجات
                    </span>
                </a>


                <a
                    href="/admin/coupons"
                    class="nav-item"
                >
                    <span class="nav-icon">
                        🎟️
                    </span>

                    <span>
                        الكوبونات
                    </span>
                </a>


                <div class="nav-title">
                    الموظفون والدعم
                </div>

                <a
                    href="/admin/call-center-agents"
                    class="nav-item"
                >
                    <span class="nav-icon">
                        👨‍💼
                    </span>

                    <span>
                        موظفو الكول سنتر
                    </span>
                </a>


                <a
                    href="/admin/support/ratings"
                    class="nav-item"
                >
                    <span class="nav-icon">
                        ⭐
                    </span>

                    <span>
                        تقييمات وأداء الموظفين
                    </span>
                </a>

            </nav>


            <div class="sidebar-bottom">

                <a
                    href="/logout"
                    class="sidebar-logout"
                >
                    🚪 تسجيل الخروج
                </a>

            </div>

        </aside>


        <!-- =========================================
             MAIN
        ========================================== -->

        <main class="main-content">

            <!-- =====================================
                 TOP HEADER
            ====================================== -->

            <header class="top-header">

                <div>

                    <span class="top-label">
                        911 RESTAURANT
                    </span>

                    <h1>
                        لوحة تحكم الأدمن
                    </h1>

                    <p>
                        إدارة ومتابعة جميع عمليات المطعم
                    </p>

                </div>


                <div class="top-brand">
                    911
                </div>

            </header>


            <!-- =====================================
                 WELCOME
            ====================================== -->

            <section class="welcome-section">

                <div>

                    <h2>
                        مرحباً بك في لوحة التحكم 👋
                    </h2>

                    <p>
                        من هنا يمكنك متابعة الطلبات
                        وإدارة المنتجات والكوبونات
                        والموظفين ومراجعة أداء الدعم.
                    </p>

                </div>

                <div class="live-indicator">

                    <span class="live-dot"></span>

                    النظام يعمل

                </div>

            </section>


            <!-- =====================================
                 STATISTICS
            ====================================== -->

            <section class="dashboard-section">

                <div class="section-heading">

                    <div>
                        <span>
                            نظرة سريعة
                        </span>

                        <h2>
                            إحصائيات اليوم
                        </h2>
                    </div>

                    <div class="section-note">
                        آخر 24 ساعة
                    </div>

                </div>


                <div class="stats-grid">


                    <!-- Total Orders -->

                    <div class="stat-card">

                        <div class="stat-card-top">

                            <div class="stat-icon orange">
                                📦
                            </div>

                            <span class="stat-tag">
                                الطلبات
                            </span>

                        </div>

                        <span class="stat-label">
                            إجمالي الطلبات
                        </span>

                        <strong class="stat-value">
                            <%= stats.total_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Sales -->

                    <div class="stat-card sales-card">

                        <div class="stat-card-top">

                            <div class="stat-icon green">
                                💰
                            </div>

                            <span class="stat-tag">
                                مبيعات
                            </span>

                        </div>

                        <span class="stat-label">
                            مبيعات اليوم
                        </span>

                        <strong class="stat-value">
                            <%= Number(
                                stats.total_sales || 0
                            ).toFixed(2) %>
                            <small>
                                د.أ
                            </small>
                        </strong>

                    </div>


                    <!-- Pending -->

                    <div class="stat-card pending-card">

                        <div class="stat-card-top">

                            <div class="stat-icon yellow">
                                🟠
                            </div>

                            <span class="stat-tag">
                                جديد
                            </span>

                        </div>

                        <span class="stat-label">
                            قيد الانتظار
                        </span>

                        <strong class="stat-value">
                            <%= stats.pending_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Confirmed -->

                    <div class="stat-card blue-card">

                        <div class="stat-card-top">

                            <div class="stat-icon blue">
                                🔵
                            </div>

                            <span class="stat-tag">
                                مؤكد
                            </span>

                        </div>

                        <span class="stat-label">
                            تم التأكيد
                        </span>

                        <strong class="stat-value">
                            <%= stats.confirmed_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Preparing -->

                    <div class="stat-card purple-card">

                        <div class="stat-card-top">

                            <div class="stat-icon purple">
                                🟣
                            </div>

                            <span class="stat-tag">
                                مطبخ
                            </span>

                        </div>

                        <span class="stat-label">
                            قيد التحضير
                        </span>

                        <strong class="stat-value">
                            <%= stats.preparing_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Ready -->

                    <div class="stat-card green-card">

                        <div class="stat-card-top">

                            <div class="stat-icon green-dark">
                                🟢
                            </div>

                            <span class="stat-tag">
                                جاهز
                            </span>

                        </div>

                        <span class="stat-label">
                            جاهز
                        </span>

                        <strong class="stat-value">
                            <%= stats.ready_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Delivered -->

                    <div class="stat-card cyan-card">

                        <div class="stat-card-top">

                            <div class="stat-icon cyan">
                                🚚
                            </div>

                            <span class="stat-tag">
                                مكتمل
                            </span>

                        </div>

                        <span class="stat-label">
                            تم التوصيل
                        </span>

                        <strong class="stat-value">
                            <%= stats.delivered_orders || 0 %>
                        </strong>

                    </div>


                    <!-- Cancelled -->

                    <div class="stat-card red-card">

                        <div class="stat-card-top">

                            <div class="stat-icon red">
                                🔴
                            </div>

                            <span class="stat-tag">
                                ملغي
                            </span>

                        </div>

                        <span class="stat-label">
                            الطلبات الملغاة
                        </span>

                        <strong class="stat-value">
                            <%= stats.cancelled_orders || 0 %>
                        </strong>

                    </div>

                </div>

            </section>


            <!-- =====================================
                 RESTAURANT STATUS
            ====================================== -->

            <section class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span>
                            حالة التشغيل
                        </span>

                        <h2>
                            حالة المطعم
                        </h2>

                    </div>

                </div>


                <div class="restaurant-status-card">

                    <% if (restaurant && restaurant.is_open) { %>

                        <div class="restaurant-status-content open">

                            <div class="restaurant-status-main">

                                <div class="restaurant-status-icon">
                                    🟢
                                </div>

                                <div>

                                    <span class="status-badge open">
                                        مفتوح الآن
                                    </span>

                                    <h3>
                                        المطعم شغال
                                    </h3>

                                    <p>
                                        المطعم مفتوح حالياً ويستقبل الطلبات.
                                    </p>

                                </div>

                            </div>


                            <form
                                action="/admin/restaurant/toggle"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="restaurant-toggle-btn close-btn"
                                >
                                    إغلاق المطعم
                                </button>

                            </form>

                        </div>

                    <% } else { %>

                        <div class="restaurant-status-content closed">

                            <div class="restaurant-status-main">

                                <div class="restaurant-status-icon">
                                    🔴
                                </div>

                                <div>

                                    <span class="status-badge closed">
                                        مغلق الآن
                                    </span>

                                    <h3>
                                        المطعم مغلق
                                    </h3>

                                    <p>
                                        المطعم مغلق حالياً ولا يتم استقبال الطلبات.
                                    </p>

                                </div>

                            </div>


                            <form
                                action="/admin/restaurant/toggle"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="restaurant-toggle-btn open-btn"
                                >
                                    تشغيل المطعم
                                </button>

                            </form>

                        </div>

                    <% } %>

                </div>

            </section>


            <!-- =====================================
                 QUICK MANAGEMENT
            ====================================== -->

            <section class="dashboard-section">

                <div class="section-heading">

                    <div>

                        <span>
                            النظام
                        </span>

                        <h2>
                            الإدارة السريعة
                        </h2>

                    </div>

                    <div class="section-note">
                        الوصول المباشر
                    </div>

                </div>


                <div class="management-grid">


                    <!-- Products -->

                    <a
                        href="/admin/products"
                        class="management-card"
                    >

                        <div class="management-icon">
                            🍔
                        </div>

                        <div class="management-content">

                            <h3>
                                المنتجات
                            </h3>

                            <p>
                                إضافة وتعديل وحذف المنتجات
                                وإدارة قائمة الطعام.
                            </p>

                            <span class="management-link">
                                فتح الإدارة →
                            </span>

                        </div>

                    </a>


                    <!-- Orders -->

                    <a
                        href="/admin/orders"
                        class="management-card"
                    >

                        <div class="management-icon">
                            📦
                        </div>

                        <div class="management-content">

                            <h3>
                                الطلبات
                            </h3>

                            <p>
                                متابعة جميع الطلبات
                                ومراجعة حالة كل طلب.
                            </p>

                            <span class="management-link">
                                فتح الإدارة →
                            </span>

                        </div>

                    </a>


                    <!-- Coupons -->

                    <a
                        href="/admin/coupons"
                        class="management-card"
                    >

                        <div class="management-icon">
                            🎟️
                        </div>

                        <div class="management-content">

                            <h3>
                                الكوبونات
                            </h3>

                            <p>
                                إنشاء وإدارة وتفعيل وتعطيل
                                كوبونات الخصم.
                            </p>

                            <span class="management-link">
                                فتح الإدارة →
                            </span>

                        </div>

                    </a>


                    <!-- Call Center -->

                    <a
                        href="/admin/call-center-agents"
                        class="management-card"
                    >

                        <div class="management-icon">
                            👨‍💼
                        </div>

                        <div class="management-content">

                            <h3>
                                موظفو الكول سنتر
                            </h3>

                            <p>
                                إدارة الموظفين وحساباتهم
                                وحالات التفعيل.
                            </p>

                            <span class="management-link">
                                فتح الإدارة →
                            </span>

                        </div>

                    </a>


                    <!-- Support Ratings -->

                    <a
                        href="/admin/support/ratings"
                        class="management-card featured"
                    >

                        <div class="management-icon">
                            ⭐
                        </div>

                        <div class="management-content">

                            <h3>
                                تقييمات وأداء الموظفين
                            </h3>

                            <p>
                                عدد المحادثات والردود
                                والتقييمات ومتوسط أداء الموظفين.
                            </p>

                            <span class="management-link">
                                عرض التقارير →
                            </span>

                        </div>

                    </a>

                </div>

            </section>


            <!-- =====================================
                 FOOTER
            ====================================== -->

            <footer class="dashboard-footer">

                <div>
                    <strong>
                        911 Restaurant
                    </strong>
                </div>

                <div>
                    لوحة تحكم الإدارة © 2026
                </div>

            </footer>

        </main>

    </div>

</body>
</html>