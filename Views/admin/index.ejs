<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>لوحة تحكم الأدمن - 911</title>

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

</head>

<body>

<div class="dashboard">

    <!-- ================= HEADER ================= -->

    <header class="header">

        <div>

            <h1>911</h1>

            <p>
                لوحة تحكم الأدمن
            </p>

        </div>


        <div class="header-actions">

            <a
                href="/logout"
                class="logout-btn"
            >
                تسجيل الخروج
            </a>

            <div class="logo">
                911
            </div>

        </div>

    </header>


    <!-- ================= CONTENT ================= -->

    <main class="content">

        <h2>
            مرحباً بك 👋
        </h2>

        <p class="description">
            نظرة سريعة على أداء المطعم اليوم.
        </p>


        <!-- ================= STATS ================= -->

        <div class="stats-grid">


            <!-- إجمالي الطلبات -->

            <div class="stat-card">

                <div class="stat-icon">
                    📦
                </div>

                <div>

                    <span>
                        إجمالي الطلبات
                    </span>

                    <strong>
                        <%= stats.total_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- المبيعات -->

            <div class="stat-card">

                <div class="stat-icon">
                    💰
                </div>

                <div>

                    <span>
                        مبيعات اليوم
                    </span>

                    <strong>
                        <%= Number(stats.total_sales || 0).toFixed(2) %> د.أ
                    </strong>

                </div>

            </div>


            <!-- قيد الانتظار -->

            <div class="stat-card pending">

                <div class="stat-icon">
                    🟠
                </div>

                <div>

                    <span>
                        قيد الانتظار
                    </span>

                    <strong>
                        <%= stats.pending_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- تم التأكيد -->

            <div class="stat-card confirmed">

                <div class="stat-icon">
                    🔵
                </div>

                <div>

                    <span>
                        تم التأكيد
                    </span>

                    <strong>
                        <%= stats.confirmed_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- قيد التحضير -->

            <div class="stat-card preparing">

                <div class="stat-icon">
                    🟣
                </div>

                <div>

                    <span>
                        قيد التحضير
                    </span>

                    <strong>
                        <%= stats.preparing_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- جاهز -->

            <div class="stat-card ready">

                <div class="stat-icon">
                    🟢
                </div>

                <div>

                    <span>
                        جاهز
                    </span>

                    <strong>
                        <%= stats.ready_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- تم التوصيل -->

            <div class="stat-card delivered">

                <div class="stat-icon">
                    🚚
                </div>

                <div>

                    <span>
                        تم التوصيل
                    </span>

                    <strong>
                        <%= stats.delivered_orders || 0 %>
                    </strong>

                </div>

            </div>


            <!-- ملغي -->

            <div class="stat-card cancelled">

                <div class="stat-icon">
                    🔴
                </div>

                <div>

                    <span>
                        ملغي
                    </span>

                    <strong>
                        <%= stats.cancelled_orders || 0 %>
                    </strong>

                </div>

            </div>


        </div>


        <!-- ================= QUICK ACTIONS ================= -->

        <h2 class="section-title">
            الإدارة السريعة
        </h2>


        <div class="cards">

    <a
        href="/admin/products"
        class="card"
    >
        <div class="icon">🍔</div>

        <div>
            <h3>المنتجات</h3>

            <p>
                عرض وإضافة وتعديل وحذف المنتجات
            </p>
        </div>
    </a>


    <a
        href="/admin/orders"
        class="card"
    >
        <div class="icon">📦</div>

        <div>
            <h3>الطلبات</h3>

            <p>
                عرض ومتابعة جميع طلبات المطعم
            </p>
        </div>
    </a>

</div>


    </main>


    <!-- ================= FOOTER ================= -->

    <footer>

        <p>
            911 Restaurant © 2026
        </p>

    </footer>

</div>

</body>

</html>