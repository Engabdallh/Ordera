<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>تعديل موظف الكول سنتر</title>

    <link rel="stylesheet" href="/css/admin/call-center-agents.css">
</head>

<body>

    <div class="container">

        <div class="page-header">

            <div>
                <h1>تعديل موظف الكول سنتر</h1>
                <p>تعديل بيانات الموظف وكلمة المرور</p>
            </div>

            <a
                href="/admin/call-center-agents"
                class="back-btn"
            >
                العودة للموظفين
            </a>

        </div>


        <div class="card">

            <h2>بيانات الموظف</h2>

            <form
                action="/admin/call-center-agents/edit/<%= agent.id %>"
                method="POST"
                class="agent-form"
            >

                <div class="form-group">

                    <label for="name">
                        اسم الموظف
                    </label>

                    <input
                        type="text"
                        id="name"
                        name="name"
                        value="<%= agent.name %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="phone">
                        رقم الهاتف
                    </label>

                    <input
                        type="text"
                        id="phone"
                        name="phone"
                        value="<%= agent.phone || '' %>"
                    >

                </div>


                <div class="form-group">

                    <label for="email">
                        البريد الإلكتروني
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        value="<%= agent.email %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="password">
                        كلمة المرور الجديدة
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="اتركها فارغة إذا لم ترد تغييرها"
                    >

                </div>


                <div class="form-group">

                    <label for="confirmPassword">
                        تأكيد كلمة المرور الجديدة
                    </label>

                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        placeholder="اتركها فارغة إذا لم ترد تغييرها"
                    >

                </div>


                <button
                    type="submit"
                    class="add-btn"
                >
                    حفظ التعديلات
                </button>

            </form>

        </div>

    </div>

</body>
</html>