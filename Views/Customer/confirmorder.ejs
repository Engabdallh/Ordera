<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>تأكيد الطلب - 911</title>

    <link
        rel="stylesheet"
        href="/css/customer/confirm-order.css"
    >

</head>

<body>

<div class="container">

    <div class="header">

        <div>
            <h1>911</h1>

            <h2>
                تأكيد الطلب 📦
            </h2>

            <p>
                أهلاً بك، <%= userName %>
            </p>
        </div>

        <a href="/cart" class="back-btn">
            العودة للسلة
        </a>

    </div>


    <div class="confirm-box">

        <h2>
            معلومات التوصيل
        </h2>

        <p class="description">
            يرجى إدخال رقم الهاتف وعنوان التوصيل لهذا الطلب.
        </p>


        <form
            action="/cart/checkout"
            method="POST"
        >

            <div class="form-group">

                <label>
                    رقم الهاتف
                </label>

                <input
                    type="tel"
                    name="delivery_phone"
                    placeholder="مثال: 0791234567"
                    required
                >

            </div>


            <div class="form-group">

                <label>
                    عنوان التوصيل
                </label>

                <textarea
                    name="delivery_address"
                    placeholder="مثال: إربد، شارع الجامعة، بناية رقم 10"
                    required
                ></textarea>

            </div>


            <div class="buttons">

                <a
                    href="/cart"
                    class="cancel-btn"
                >
                    إلغاء
                </a>

                <button
                    type="submit"
                    class="confirm-btn"
                >
                    تأكيد الطلب
                </button>

            </div>

        </form>

    </div>

</div>

</body>

</html>