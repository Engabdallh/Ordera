<!DOCTYPE html>

<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        تفاصيل الطلب #<%= order.daily_order_number %> - 911
    </title>

    <link rel="stylesheet" href="/css/customer/orderdetails.css">

</head>

<body>

    <div class="container">

        <header class="header">

            <div>

                <h1>
                    911
                </h1>

                <h2>
                    تفاصيل الطلب #<%= order.daily_order_number %>
                </h2>

                <p>
                    أهلاً بك، <%= userName %>
                </p>

            </div>

            <a href="/orders" class="back-btn">
                ← العودة لطلباتي
            </a>

        </header>


        <main>

            <!-- =========================
                 معلومات الطلب
            ========================== -->

            <section class="details-section">

                <h3>
                    معلومات الطلب
                </h3>

                <div class="order-info-grid">

                    <div class="info-card">

                        <span>
                            رقم الطلب
                        </span>

                        <strong>
                            #<%= order.daily_order_number %>
                        </strong>

                    </div>


                    <div class="info-card">

                        <span>
                            الحالة
                        </span>

                        <strong>
                            <%= order.status %>
                        </strong>

                    </div>


                    <div class="info-card">

                        <span>
                            نوع الطلب
                        </span>

                        <strong>
                            <%= order.order_type %>
                        </strong>

                    </div>


                    <div class="info-card">

                        <span>
                            المبلغ الإجمالي
                        </span>

                        <strong>
                            <%= Number(order.total_price).toFixed(2) %> د.أ
                        </strong>

                    </div>

                </div>

            </section>


            <!-- =========================
                 العنوان
            ========================== -->

            <section class="details-section">

                <h3>
                    عنوان التوصيل
                </h3>

                <div class="address-box">

                    <%= order.delivery_address || "غير متوفر" %>

                </div>

            </section>


            <!-- =========================
                 المنتجات
            ========================== -->

            <section class="details-section">

                <h3>
                    المنتجات
                </h3>

                <% if (items && items.length> 0) { %>

                    <div class="items-list">

                        <% items.forEach((item)=> { %>

                            <div class="item-card">

                                <% if (item.image) { %>

                                    <img src="<%= item.image %>" alt="<%= item.name %>">

                                    <% } %>


                                        <div class="item-info">

                                            <h4>
                                                <%= item.name %>
                                            </h4>

                                            <p>
                                                الكمية:
                                                <%= item.quantity %>
                                            </p>

                                            <strong>
                                                <%= Number(item.price).toFixed(2) %> د.أ
                                            </strong>

                                        </div>

                            </div>

                            <% }) %>

                    </div>

                    <% } else { %>

                        <div class="empty-box">
                            لا توجد منتجات في هذا الطلب.
                        </div>

                        <% } %>

            </section>

        </main>


        <footer>

            <p>
                911 Restaurant © 2026
            </p>

        </footer>

    </div>

</body>

</html>