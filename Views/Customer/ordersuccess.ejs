<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>تم تأكيد الطلب - 911</title>

    <link rel="stylesheet" href="/css/customer/ordersuccess.css">
</head>

<body>

    <div class="container">

        <div class="success-box">

            <div class="icon">
                ✓
            </div>

            <h1>
                تم تأكيد طلبك 🎉
            </h1>

            <p>
                شكرًا لك، تم استلام طلبك بنجاح.
            </p>

            <div class="order-info">

                <div>
                    <span>
                        رقم الطلب
                    </span>

                    <strong>
                        #<%= dailyOrderNumber %>
                    </strong>
                </div>

                <div>
                    <span>
                        إجمالي الطلب
                    </span>

                    <strong>
                        <%= totalPrice %> د.أ
                    </strong>
                </div>

                <div>
                    <span>
                        حالة الطلب
                    </span>

                    <strong>
                        قيد الانتظار
                    </strong>
                </div>

            </div>


            <% if (guestTrackingToken) { %>

                <div class="guest-tracking-box">

                    <h2>
                        🔐 رمز الطلب
                    </h2>

                    <p>
                        احتفظ برقم الطلب ورمز الطلب.
                        عند التواصل مع المطعم للاستفسار عن طلبك،
                        قد يُطلب منك تقديم هذه المعلومات.
                    </p>

                    <div class="tracking-token">
                        <%= guestTrackingToken %>
                    </div>

                    <div class="restaurant-contact">

                        <span>
                            📞 للاستفسار عن طلبك:
                        </span>

                        <a href="tel:0790000000">
                            0790000000
                        </a>

                    </div>

                    <p class="tracking-warning">
                        ⚠️ احتفظ بالرمز ورقم الطلب عند الاتصال بالمطعم.
                    </p>

                </div>

                <% } %>


                    <a href="/products" class="products-btn">
                        العودة للمنتجات
                    </a>

        </div>

    </div>

</body>

</html>