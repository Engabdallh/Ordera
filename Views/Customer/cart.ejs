<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>السلة - 911</title>

    <link rel="stylesheet" href="/css/customer/cart.css">

</head>

<body>

    <div class="container">

        <!-- Header -->

        <div class="header">

            <div>

                <h1>911</h1>

                <h2>
                    سلة الطلب 🛒
                </h2>

                <p>
                    أهلاً بك، <%= userName %>
                </p>

            </div>

            <a href="/products" class="back-btn">
                العودة للمنتجات
            </a>

        </div>


        <% if (cart.length===0) { %>

            <!-- السلة فارغة -->

            <div class="empty">

                <h2>
                    السلة فارغة 🛒
                </h2>

                <p>
                    لم تقم باختيار أي منتج بعد.
                </p>

                <a href="/products">
                    تصفح المنتجات
                </a>

            </div>


            <% } else { %>


                <!-- المنتجات -->

                <div class="cart">

                    <% cart.forEach(item=> { %>

                        <div class="cart-item">

                            <% if (item.image) { %>

                                <img src="<%= item.image %>" alt="<%= item.name %>">

                                <% } %>


                                    <div class="item-info">

                                        <h3>
                                            <%= item.name %>
                                        </h3>


                                        <p>

                                            سعر القطعة:

                                            <%= Number(item.price).toFixed(2) %>

                                                د.أ

                                        </p>


                                        <!-- التحكم بالكمية -->

                                        <div class="quantity">

                                            <form action="/cart/decrease/<%= item.productId %>" method="POST">

                                                <button type="submit" class="quantity-btn">
                                                    −
                                                </button>

                                            </form>


                                            <span>
                                                <%= item.quantity %>
                                            </span>


                                            <form action="/cart/increase/<%= item.productId %>" method="POST">

                                                <button type="submit" class="quantity-btn">
                                                    +
                                                </button>

                                            </form>

                                        </div>


                                        <!-- مجموع المنتج -->

                                        <strong class="item-total">

                                            المجموع:

                                            <%= ( Number(item.price) * item.quantity ).toFixed(2) %>

                                                د.أ

                                        </strong>


                                        <!-- حذف -->

                                        <form action="/cart/remove/<%= item.productId %>" method="POST">

                                            <button type="submit" class="delete-btn">
                                                🗑️ حذف
                                            </button>

                                        </form>

                                    </div>

                        </div>

                        <% }) %>

                </div>

                <!-- ============================== -->
                <!-- كوبون الخصم -->
                <!-- ============================== -->

                <div class="coupon-section">

                    <h3>🎟️ هل لديك كوبون خصم؟</h3>

                    <% if (isGuest) { %>

                        <div class="coupon-disabled">
                            🔒 الكوبونات متاحة فقط للمستخدمين المسجلين.
                            <br>
                            <span>
                                سجّل حسابًا للاستفادة من العروض والكوبونات.
                            </span>
                        </div>

                        <% } else { %>

                            <form action="/cart/apply-coupon" method="POST" class="coupon-form">

                                <input type="text" name="code" placeholder="أدخل كود الخصم" maxlength="50" required>

                                <button type="submit">
                                    تطبيق
                                </button>

                            </form>

                            <% if (couponError) { %>

                                <p class="coupon-error">
                                    <%= couponError %>
                                </p>

                                <% } %>

                                    <% if (couponSuccess) { %>

                                        <p class="coupon-success">
                                            <%= couponSuccess %>
                                        </p>

                                        <% } %>

                                            <% } %>

                </div>

                <!-- ============================== -->
                <!-- إجمالي الطلب والخصم -->
                <!-- ============================== -->

                <% const cartSubtotal=cart.reduce( (total, item)=>
                    total +
                    Number(item.price) * item.quantity,
                    0
                    );

                    const finalSubtotal = Number(cartSubtotal).toFixed(2);

                    const discountAmount = coupon
                    ? Number(coupon.discountAmount).toFixed(2)
                    : "0.00";

                    const finalTotal = coupon
                    ? Number(coupon.totalPrice).toFixed(2)
                    : finalSubtotal;
                    %>

                    <div class="total">

                        <div class="total-row">
                            <span>المجموع:......</span>
                            <strong class="final-price">
                                <%= finalSubtotal %> د.أ
                            </strong>
                        </div>

                        <% if (coupon) { %>

                            <div class="total-row discount-row">
                                <span>
                                    الخصم (<%= coupon.couponCode %>):.....
                                </span>

                                <strong class="final-price">
                                    -<%= discountAmount %> د.أ
                                </strong>
                            </div>

                            <% } %>

                                <div class="total-row final-total">
                                    <span>الإجمالي النهائي:.....</span>

                                    <strong class="final-price">
                                        <%= finalTotal %> د.أ
                                    </strong>
                                </div>

                    </div>


                    <!-- أزرار السلة -->

                    <div class="cart-actions">

                        <!-- تفريغ السلة -->

                        <form action="/cart/clear" method="POST">

                            <button type="submit" class="clear-btn">
                                🗑️ تفريغ السلة
                            </button>

                        </form>


                        <!-- تأكيد الطلب -->

                        <button type="button" class="order-btn" onclick="openOrderModal()">
                            تأكيد الطلب
                        </button>

                    </div>


                    <% } %>

    </div>


    <!-- ========================================= -->
    <!-- نافذة تأكيد الطلب -->
    <!-- ========================================= -->

    <div id="orderModal" class="modal">

        <div class="modal-box">

            <div class="order-icon">
                🛒
            </div>


            <h2>
                تأكيد الطلب
            </h2>


            <p>
                قبل إرسال الطلب، يرجى إدخال رقم الهاتف
                وعنوان التوصيل.
            </p>


            <!-- نموذج الطلب -->

            <form action="/cart/checkout" method="POST" class="checkout-form">


                <% if (isGuest) { %>

                    <div class="form-group">

                        <label for="guestName">
                            الاسم
                        </label>

                        <input type="text" id="guestName" name="guestName" placeholder="اكتب اسمك" maxlength="100"
                            required>

                    </div>

                    <% } %>
                        <!-- رقم الهاتف -->

                        <div class="form-group">

                            <label for="phone">
                                رقم الهاتف
                            </label>

                            <input type="tel" id="phone" name="phone" placeholder="مثال: 0791234567" required>

                        </div>


                        <!-- العنوان -->

                        <div class="form-group">

                            <label for="address">
                                عنوان التوصيل
                            </label>

                            <textarea id="address" name="address" placeholder="اكتب عنوان التوصيل بالتفصيل..." rows="3"
                                required></textarea>

                        </div>


                        <!-- أزرار -->

                        <div class="modal-buttons">

                            <button type="button" class="cancel-btn" onclick="closeOrderModal()">
                                إلغاء
                            </button>


                            <button type="submit" class="confirm-btn">
                                نعم، تأكيد الطلب
                            </button>

                        </div>

            </form>

        </div>

    </div>


    <script>

        const orderModal =
            document.getElementById("orderModal");


        function openOrderModal() {

            orderModal.style.display = "flex";

        }


        function closeOrderModal() {

            orderModal.style.display = "none";

        }


        // إغلاق النافذة عند الضغط خارجها

        window.onclick = function (event) {

            if (event.target === orderModal) {

                closeOrderModal();

            }

        };

    </script>


</body>

</html>