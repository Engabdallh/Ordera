<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    >

    <meta
        name="theme-color"
        content="#0a0a0a"
    >

    <title>
        مرحبًا بك - 911
    </title>

    <link
        rel="stylesheet"
        href="/css/welcome.css"
    >

</head>

<body>

    <main class="welcome-page">

        <section class="welcome-card">


            <!-- =================================
                 TOP BRAND
            ================================== -->

            <div class="brand-area">


                <div class="brand-name">
                    سلسلة مطاعم
                </div>

                <div class="logo">
                    911
                </div>

                

            </div>


            <!-- =================================
                 HERO
            ================================== -->

            <div class="hero">

                <div class="hero-badge">
                    🍔 اطلب بسهولة
                </div>

                <h1>
                    أهلاً وسهلاً بك 👋
                </h1>

                <p class="subtitle">
                    وجبتك المفضلة أقرب مما تتوقع
                </p>

                <p class="hero-description">
                    تصفح القائمة، أضف طلبك إلى السلة
                    واستمتع بتجربة طلب بسيطة وسريعة.
                </p>

            </div>


            <!-- =================================
                 ACCOUNT BENEFITS
            ================================== -->

            <section class="account-benefits">

                <div class="section-heading">

                    <span>
                        تجربة أفضل
                    </span>

                    <h2>
                        لماذا تنشئ حسابًا؟
                    </h2>

                </div>


                <div class="benefits">


                    <!-- ORDER HISTORY -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            📋
                        </div>

                        <div class="benefit-content">

                            <strong>
                                سجل طلباتك
                            </strong>

                            <p>
                                احتفظ بطلباتك السابقة
                                في حسابك.
                            </p>

                        </div>

                    </div>


                    <!-- SUPPORT -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            💬
                        </div>

                        <div class="benefit-content">

                            <strong>
                                دعم العملاء
                            </strong>

                            <p>
                                تواصل مباشرة مع
                                موظف الكول سنتر.
                            </p>

                        </div>

                    </div>


                    <!-- SUPPORT HISTORY -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            🔄
                        </div>

                        <div class="benefit-content">

                            <strong>
                                متابعة محادثتك
                            </strong>

                            <p>
                                ارجع للمحادثة الحالية
                                وكمل من مكان ما توقفت.
                            </p>

                        </div>

                    </div>


                    <!-- RATING -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            ⭐
                        </div>

                        <div class="benefit-content">

                            <strong>
                                تقييم الدعم
                            </strong>

                            <p>
                                قيّم تجربة التواصل
                                بعد انتهاء المحادثة.
                            </p>

                        </div>

                    </div>


                    <!-- COUPONS -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            🎟️
                        </div>

                        <div class="benefit-content">

                            <strong>
                                الكوبونات
                            </strong>

                            <p>
                                استخدم كوبونات الخصم
                                المتاحة أثناء الطلب.
                            </p>

                        </div>

                    </div>


                    <!-- ACCOUNT -->

                    <div class="benefit">

                        <div class="benefit-icon">
                            👤
                        </div>

                        <div class="benefit-content">

                            <strong>
                                تجربة مرتبطة بحسابك
                            </strong>

                            <p>
                                معلوماتك وطلباتك تبقى
                                مرتبطة بحسابك.
                            </p>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================
                 MAIN ACTIONS
            ================================== -->

            <section class="main-actions">

                <a
                    href="/login"
                    class="primary-btn"
                >

                    <span class="button-icon">
                        🔐
                    </span>

                    <span>
                        تسجيل الدخول
                    </span>

                </a>


                <a
                    href="/register"
                    class="secondary-btn"
                >

                    <span class="button-icon">
                        ✨
                    </span>

                    <span>
                        إنشاء حساب جديد
                    </span>

                </a>

            </section>


            <!-- =================================
                 GUEST
            ================================== -->

            <div class="divider">

                <span>
                    أو
                </span>

            </div>


            <a
                href="/guest"
                class="guest-btn"
            >

                <span>
                    🚀
                </span>

                المتابعة كزائر

            </a>


            <p class="guest-note">

                يمكنك الطلب بدون إنشاء حساب،
                لكن بعض ميزات الموقع تحتاج إلى تسجيل الدخول.

            </p>


            <!-- =================================
                 FOOTER
            ================================== -->

            <div class="welcome-footer">

                <span>
                    911 Restaurant
                </span>

                <span class="footer-dot">
                    •
                </span>

                <span>
                    اطلبها بطريقتك
                </span>

            </div>


        </section>

    </main>

</body>

</html>