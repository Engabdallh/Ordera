<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    <meta name="theme-color" content="#090909">

    <title>
        مساعدة تسجيل الدخول | 911
    </title>

    <link rel="stylesheet" href="/css/login-help.css">

</head>

<body>

    <main class="login-help-page">

        <section class="login-help-card">


            <!-- ==============================
                 BRAND
            =============================== -->

            <div class="brand-area">

                <div class="logo">
                    سلسلة مطاعم
                </div>

                <div class="brand-name">
                    911
                </div>

            </div>


            <!-- ==============================
                 TITLE
            =============================== -->

            <div class="hero">

                <span class="help-badge">
                    ❓ مساعدة
                </span>

                <h1>
                    كيف أسجل الدخول؟
                </h1>

                <p>
                    اتبع الخطوات التالية للدخول إلى حسابك
                    والاستفادة من جميع ميزات 911.
                </p>

            </div>


            <!-- ==============================
                 STEPS
            =============================== -->

            <section class="steps">


                <div class="step">

                    <div class="step-number">
                        1
                    </div>

                    <div class="step-icon">
                        👤
                    </div>

                    <div class="step-content">

                        <h3>
                            أدخل اسمك
                        </h3>

                        <p>
                            في خانة الاسم اكتب الاسم المستخدم
                            عند إنشاء حسابك.
                        </p>

                    </div>

                </div>


                <div class="step">

                    <div class="step-number">
                        2
                    </div>

                    <div class="step-icon">
                        🔒
                    </div>

                    <div class="step-content">

                        <h3>
                            أدخل كلمة السر
                        </h3>

                        <p>
                            اكتب كلمة السر الخاصة بحسابك
                            في الخانة المخصصة.
                        </p>

                    </div>

                </div>


                <div class="step">

                    <div class="step-number">
                        3
                    </div>

                    <div class="step-icon">
                        🔐
                    </div>

                    <div class="step-content">

                        <h3>
                            اضغط تسجيل الدخول
                        </h3>

                        <p>
                            بعد التأكد من البيانات اضغط
                            على زر تسجيل الدخول.
                        </p>

                    </div>

                </div>


                <div class="step">

                    <div class="step-number">
                        4
                    </div>

                    <div class="step-icon">
                        ✅
                    </div>

                    <div class="step-content">

                        <h3>
                            تم تسجيل الدخول
                        </h3>

                        <p>
                            بعد نجاح الدخول سيتم نقلك إلى
                            واجهة الحساب الخاصة بك.
                        </p>

                    </div>

                </div>


            </section>


            <!-- ==============================
                 IMPORTANT NOTE
            =============================== -->

            <div class="help-note">

                <div class="help-note-icon">
                    💡
                </div>

                <div>

                    <strong>
                        ما عندك حساب؟
                    </strong>

                    <p>
                        اضغط على "إنشاء حساب جديد"
                        من صفحة تسجيل الدخول لإنشاء حسابك.
                    </p>

                </div>

            </div>


            <!-- ==============================
                 GUEST NOTE
            =============================== -->

            <div class="guest-note">

                <div class="guest-note-icon">
                    🚀
                </div>

                <div>

                    <strong>
                        تريد الطلب بدون تسجيل؟
                    </strong>

                    <p>
                        يمكنك المتابعة كزائر وطلب وجبتك
                        بدون إنشاء حساب.
                    </p>

                </div>

            </div>


            <!-- ==============================
                 ACTIONS
            =============================== -->

            <div class="actions">

                <a href="/login" class="primary-btn">
                    🔐 العودة لتسجيل الدخول
                </a>

                <a href="/register" class="secondary-btn">
                    ✨ إنشاء حساب جديد
                </a>

                <a href="/guest" class="guest-btn">
                    🚀 المتابعة كزائر
                </a>

            </div>


            <!-- ==============================
                 FOOTER
            =============================== -->

            <footer>

                <span>
                    911 Restaurant
                </span>

                <span>
                    •
                </span>

                <span>
                    نحن هنا لمساعدتك
                </span>

            </footer>

        </section>

    </main>

</body>

</html>