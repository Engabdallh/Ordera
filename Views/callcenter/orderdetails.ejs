<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        تفاصيل الطلب #<%= order.daily_order_number %> - ordera
    </title>

    <link rel="stylesheet" href="/css/callcenter/orderdetails.css">

</head>

<body>

    <div class="dashboard">

        <!-- =========================
         Header
    ========================== -->

        <header class="header">

            <div>

                <h1>ordera</h1>

                <p>
                    تفاصيل الطلب
                </p>

            </div>

            <div class="header-actions">

                <button type="button" class="back-btn" onclick="window.location.href='/call-center'">
                    ← العودة للطلبات
                </button>

                <div class="logo">
                    ordera
                </div>

            </div>

        </header>


        <!-- =========================
         Content
        ========================== -->

        <main class="content">

            <h2>
                تفاصيل الطلب #<%= order.daily_order_number %>
            </h2>

            <p class="description">
                معلومات الطلب والزبون والمنتجات.
            </p>


            <!-- =========================
             معلومات الطلب
            ========================== -->

            <div class="order-info-grid">

                <div class="info-card">

                    <span>
                        الزبون
                    </span>

                    <strong>
                        <%= order.customer_name || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        البريد الإلكتروني
                    </span>

                    <strong>
                        <%= order.customer_email || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        رقم الهاتف
                    </span>

                    <strong>
                        <%= order.delivery_phone || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        نوع الطلب
                    </span>

                    <strong>
                        <%= order.order_type || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        الحالة
                    </span>

                    <strong>
                        <%= order.status || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        المبلغ الإجمالي
                    </span>

                    <strong>
                        <%= Number(order.total_price).toFixed(2) %> د.أ
                    </strong>

                </div>

            </div>


            <!-- =========================
             العنوان
            ========================== -->

            <div class="details-section">

                <h3>
                    عنوان التوصيل
                </h3>

                <div class="address-box">

                    <%= order.delivery_address || "غير متوفر" %>

                </div>

            </div>


            <!-- =========================
             المنتجات
            ========================== -->

            <div class="details-section">

                <h3>
                    المنتجات
                </h3>

                <% if (items && items.length> 0) { %>

                    <div class="orders-table-wrapper">

                        <table class="orders-table">

                            <thead>

                                <tr>

                                    <th>
                                        المنتج
                                    </th>

                                    <th>
                                        الكمية
                                    </th>

                                    <th>
                                        السعر
                                    </th>

                                    <th>
                                        الإجمالي
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% items.forEach(item=> { %>

                                    <tr>

                                        <td>
                                            <%= item.name %>
                                        </td>

                                        <td>
                                            <%= item.quantity %>
                                        </td>

                                        <td>
                                            <%= Number(item.price).toFixed(2) %> د.أ
                                        </td>

                                        <td>

                                            <%= ( Number(item.price) * Number(item.quantity) ).toFixed(2) %> د.أ

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } else { %>

                        <div class="no-orders">

                            لا توجد منتجات في هذا الطلب.

                        </div>

                        <% } %>

            </div>

            <!-- =========================
            الحساب والخصم
            ========================== -->

            <div class="details-section">

                <h3>
                    الحساب والخصم
                </h3>

                <div class="order-summary">

                    <div class="summary-row">
                        <span>
                            المجموع الفرعي
                        </span>

                        <strong>
                            <%= Number(order.subtotal).toFixed(2) %> د.أ
                        </strong>
                    </div>

                    <% if (order.coupon_code && Number(order.discount_amount)> 0) { %>

                        <div class="summary-row coupon-row">
                            <span>
                                الكوبون
                            </span>

                            <strong>
                                <%= order.coupon_code %>
                            </strong>
                        </div>

                        <div class="summary-row discount-row">
                            <span>
                                الخصم
                            </span>

                            <strong>
                                -<%= Number(order.discount_amount).toFixed(2) %> د.أ
                            </strong>
                        </div>

                        <% } %>

                            <div class="summary-row total-row">
                                <span>
                                    الإجمالي النهائي
                                </span>

                                <strong>
                                    <%= Number(order.total_price).toFixed(2) %> د.أ
                                </strong>
                            </div>

                </div>

            </div>

            <!-- =========================
            تغيير حالة الطلب
            ========================== -->

            <div class="details-section">

                <h3>
                    تغيير حالة الطلب
                </h3>

                <form action="/call-center/orders/<%= order.id %>/status" method="POST" class="status-form"
                    onsubmit="return validateStatusChange()">

                    <div class="status-control">

                        <label for="status">
                            الحالة الحالية:
                        </label>

                        <strong>
                            <%= order.status %>
                        </strong>

                    </div>

                    <div class="status-control">

                        <label for="status">
                            الحالة الجديدة:
                        </label>

                        <select id="status" name="status" required>

                            <option value="">
                                اختر الحالة
                            </option>

                            <% if (order.status==="قيد الانتظار" ) { %>

                                <option value="تم التأكيد">
                                    تم التأكيد
                                </option>

                                <option value="ملغي">
                                    ملغي
                                </option>

                                <% } else if (order.status==="تم التأكيد" ) { %>

                                    <option value="قيد التحضير">
                                        قيد التحضير
                                    </option>

                                    <option value="ملغي">
                                        ملغي
                                    </option>

                                    <% } else if (order.status==="قيد التحضير" ) { %>

                                        <option value="جاهز">
                                            جاهز
                                        </option>

                                        <option value="ملغي">
                                            ملغي
                                        </option>

                                        <% } else if (order.status==="جاهز" ) { %>

                                            <option value="تم التوصيل">
                                                تم التوصيل
                                            </option>

                                            <% } %>

                        </select>

                    </div>

                    <button type="submit" class="change-status-btn">
                        تحديث الحالة
                    </button>

                </form>

            </div>

            <!-- =========================
              المحادثة
            ========================== -->

            <div class="details-section chat-section">

                <h3>
                    المحادثة مع الزبون
                </h3>

                <div id="orderChat" class="order-chat" data-order-id="<%= order.id %>">
                    <div class="chat-loading">
                        جاري تحميل المحادثة...
                    </div>
                </div>

                <form id="chatForm" class="chat-form">

                    <textarea id="chatMessage" name="message" placeholder="اكتب رسالتك للزبون..." rows="3"
                        maxlength="1000" required></textarea>

                    <button type="submit" class="send-message-btn">
                        إرسال
                    </button>

                </form>

            </div>


            <!-- =========================
             الأوقات
            ========================== -->

            <div class="details-section">

                <h3>
                    معلومات الوقت
                </h3>

                <div class="order-times">
                    <% if (order.updated_at) { %>
                        <p>
                            <strong>آخر تحديث:</strong>
                            <%= new Date(order.updated_at).toLocaleString("ar-JO") %>
                        </p>
                        <% } %>

                            <p>

                                <strong>
                                    وقت إنشاء الطلب:
                                </strong>

                                <%= new Date( order.created_at ).toLocaleString("ar-JO") %>

                            </p>


                            <% if (order.status_changed_at) { %>

                                <p>

                                    <strong>
                                        وقت التأكيد:
                                    </strong>

                                    <%= new Date( order.status_changed_at ).toLocaleString("ar-JO") %>

                                </p>

                                <% } %>


                                    <% if (order.preparation_completed_at) { %>

                                        <p>


                                            <strong>
                                                وقت الجاهزية:
                                            </strong>

                                            <%= new Date( order.preparation_completed_at ).toLocaleString("ar-JO") %>

                                        </p>

                                        <% } %>

                </div>

            </div>

            <!-- =========================
             Back Button
           ========================== -->

        </main>

        <!-- =========================
         Footer
        ========================== -->

        <footer>

            <p>
                911 Restaurant © 2026
            </p>

        </footer>

    </div>

    <div id="newOrderAlert" class="new-order-alert">
        <div class="new-order-alert-icon">🔔</div>

        <div>
            <strong>طلب جديد!</strong>
            <p>تم استلام طلب جديد</p>
        </div>
    </div>

    <script src="/js/callcenter/new-orders.js"></script>
    <script src="/js/callcenter/order-chat.js"></script>

</body>

</html>