<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        تفاصيل الطلب #<%= order.id %> - 911
    </title>

    <link rel="stylesheet" href="/css/callcenter/orderdetails.css">

</head>

<body>

    <div class="dashboard">

        <!-- =========================
         Header
    ========================== -->

        <header class="header">

            <div>

                <h1>911</h1>

                <p>
                    تفاصيل الطلب
                </p>

            </div>

            <div class="header-actions">

                <button type="button" class="back-btn" onclick="history.back()">
                    ← العودة للطلبات
                </button>

                <div class="logo">
                    911
                </div>

            </div>

        </header>


        <!-- =========================
         Content
    ========================== -->

        <main class="content">

            <h2>
                تفاصيل الطلب #<%= order.id %>
            </h2>

            <p class="description">
                معلومات الطلب والزبون والمنتجات.
            </p>


            <!-- =========================
             معلومات الطلب
        ========================== -->

            <div class="order-info-grid">

                <div class="info-card">

                    <span>
                        الزبون
                    </span>

                    <strong>
                        <%= order.customer_name || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        البريد الإلكتروني
                    </span>

                    <strong>
                        <%= order.customer_email || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        رقم الهاتف
                    </span>

                    <strong>
                        <%= order.delivery_phone || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        نوع الطلب
                    </span>

                    <strong>
                        <%= order.order_type || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        الحالة
                    </span>

                    <strong>
                        <%= order.status || "غير متوفر" %>
                    </strong>

                </div>


                <div class="info-card">

                    <span>
                        المبلغ الإجمالي
                    </span>

                    <strong>
                        <%= Number(order.total_price).toFixed(2) %> د.أ
                    </strong>

                </div>

            </div>


            <!-- =========================
             العنوان
        ========================== -->

            <div class="details-section">

                <h3>
                    عنوان التوصيل
                </h3>

                <div class="address-box">

                    <%= order.delivery_address || "غير متوفر" %>

                </div>

            </div>


            <!-- =========================
             المنتجات
        ========================== -->

            <div class="details-section">

                <h3>
                    المنتجات
                </h3>

                <% if (items && items.length> 0) { %>

                    <div class="orders-table-wrapper">

                        <table class="orders-table">

                            <thead>

                                <tr>

                                    <th>
                                        المنتج
                                    </th>

                                    <th>
                                        الكمية
                                    </th>

                                    <th>
                                        السعر
                                    </th>

                                    <th>
                                        الإجمالي
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <% items.forEach(item=> { %>

                                    <tr>

                                        <td>
                                            <%= item.name %>
                                        </td>

                                        <td>
                                            <%= item.quantity %>
                                        </td>

                                        <td>
                                            <%= Number(item.price).toFixed(2) %> د.أ
                                        </td>

                                        <td>

                                            <%= ( Number(item.price) * Number(item.quantity) ).toFixed(2) %> د.أ

                                        </td>

                                    </tr>

                                    <% }) %>

                            </tbody>

                        </table>

                    </div>

                    <% } else { %>

                        <div class="no-orders">

                            لا توجد منتجات في هذا الطلب.

                        </div>

                        <% } %>

            </div>


            <!-- =========================
             الأوقات
        ========================== -->

            <div class="details-section">

                <h3>
                    معلومات الوقت
                </h3>

                <div class="order-times">
                    <% if (order.updated_at) { %>
                        <p>
                            <strong>آخر تحديث:</strong>
                            <%= new Date(order.updated_at).toLocaleString("ar-JO") %>
                        </p>
                        <% } %>

                            <p>

                                <strong>
                                    وقت إنشاء الطلب:
                                </strong>

                                <%= new Date( order.created_at ).toLocaleString("ar-JO") %>

                            </p>


                            <% if (order.status_changed_at) { %>

                                <p>

                                    <strong>
                                        وقت التأكيد:
                                    </strong>

                                    <%= new Date( order.status_changed_at ).toLocaleString("ar-JO") %>

                                </p>

                                <% } %>


                                    <% if (order.preparation_completed_at) { %>

                                        <p>


                                            <strong>
                                                وقت الجاهزية:
                                            </strong>

                                            <%= new Date( order.preparation_completed_at ).toLocaleString("ar-JO") %>

                                        </p>

                                        <% } %>

                </div>

            </div>





            <!-- =========================
             Back Button
        ========================== -->



        </main>


        <!-- =========================
         Footer
    ========================== -->

        <footer>

            <p>
                911 Restaurant © 2026
            </p>

        </footer>

    </div>

</body>

</html>