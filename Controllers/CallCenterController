const OrderService = require("../Services/OrderService");
const CallCenterService = require("../Services/CallCenterService");

const orderService = new OrderService();
const callCenterService = new CallCenterService();

// =====================================================
// التحقق أن المستخدم Call Center
// =====================================================

const checkCallCenter = (req, res) => {
  if (!req.session.userId || req.session.role !== "call_center") {
    res.redirect("/login");
    return false;
  }

  return true;
};

// =====================================================
// عرض طلبات اليوم للكول سنتر
// =====================================================

const showTodayOrders = async (req, res) => {
  try {
    if (!checkCallCenter(req, res)) {
      return;
    }

    const userId = req.session.userId;
    const userName = req.session.userName;

    console.log("CALL CENTER ID:", userId);
    console.log("CALL CENTER NAME:", userName);

    const { search = "", status = "", page = 1 } = req.query;

    console.log("FILTER SEARCH:", search);
    console.log("FILTER STATUS:", status);

    const orders = await callCenterService.getTodayOrdersForCallCenter({
      search,
      status,
      page: Number(page),
      limit: 10,
    });

    const totalOrders = await callCenterService.getOrdersCountForCallCenter({
      search,
      status,
    });

    const totalPages = Math.ceil(totalOrders / 10);

    for (const order of orders) {
      order.items = await callCenterService.getOrderItemsForCallCenter(
        order.id,
      );
    }

    console.log("CALL CENTER ORDERS:", orders);

    res.render("callcenter/orders", {
      orders: orders,
      userName: userName,
      page: Number(page),
      totalPages: totalPages,
      filters: {
        search: req.query.search || "",
        status: req.query.status || "",
      },
    });
  } catch (error) {
    console.error("SHOW CALL CENTER ORDERS ERROR:", error);

    res.status(500).send("حدث خطأ أثناء عرض طلبات الكول سنتر");
  }
};

// =====================================================
// تغيير حالة الطلب
// =====================================================

const updateOrderStatus = async (req, res) => {
  try {
    if (!checkCallCenter(req, res)) {
      return;
    }

    const orderId = Number(req.params.id);
    const newStatus = req.body.status;

    console.log("UPDATE ORDER STATUS");
    console.log("ORDER ID:", orderId);
    console.log("NEW STATUS:", newStatus);

    if (!orderId || !newStatus) {
      return res.status(400).json({
        success: false,
        message: "بيانات غير صحيحة",
      });
    }

    await callCenterService.updateOrderStatus(orderId, newStatus);

    console.log("ORDER STATUS UPDATED:", orderId, newStatus);

    return res.redirect(`/call-center/orders/${orderId}`);
  } catch (error) {
    console.error("UPDATE ORDER STATUS ERROR:", error);

    return res.status(500).json({
      success: false,
      message: error.message,
    });
  }
};

const showOrderDetails = async (req, res) => {
  try {
    if (!checkCallCenter(req, res)) return;

    const orderId = Number(req.params.id);

    if (!orderId) {
      return res.status(400).send("رقم الطلب غير صحيح");
    }

    const order = await orderService.getOrderById(orderId);

    if (!order) {
      return res.status(404).send("الطلب غير موجود");
    }

    const items = await orderService.getOrderItems(orderId);

    res.render("callcenter/orderdetails", {
      order: order,
      items: items,
      userName: req.session.userName,
    });
  } catch (error) {
    console.error("CALL CENTER ORDER DETAILS ERROR:", error);

    res.status(500).send("حدث خطأ أثناء تحميل تفاصيل الطلب");
  }
};

const getNewOrdersCount = async (req, res) => {
  try {
    if (!checkCallCenter(req, res)) {
      return;
    }

    const result = await callCenterService.getNewOrdersCount();

    return res.json({
      success: true,
      count: result.count,
      latestOrderId: result.latestOrderId,
    });
  } catch (error) {
    console.error("GET NEW ORDERS COUNT ERROR:", error);

    return res.status(500).json({
      success: false,
      count: 0,
    });
  }
};

// =====================================================
// Export
// =====================================================

module.exports = {
  showTodayOrders,

  updateOrderStatus,

  showOrderDetails,

  getNewOrdersCount,
};
